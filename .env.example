# Copy this file to .env for local development. Never commit the copied .env.

# API runtime
NODE_ENV=development
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
# Set this to the exact number of trusted reverse-proxy hops in production.
TRUST_PROXY_HOPS=0

# External providers
OPENROUTESERVICE_API_KEY=your_local_key
NLR_API_KEY=your_local_key

# Local infrastructure — activated in CHG-011
DATABASE_URL=postgresql://chargewise:chargewise@localhost:5433/chargewise
TEST_DATABASE_URL=postgresql://chargewise:chargewise@localhost:5433/chargewise_test
REDIS_URL=redis://localhost:6379

# Authentication — activated in CHG-021
SESSION_SECRET=replace_with_at_least_32_random_characters
