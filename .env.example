# Copy this file to .env for local development. Never commit the copied .env.

# API runtime
NODE_ENV=development
# Render provides PORT and RENDER_EXTERNAL_URL automatically. Local development
# uses the explicit values below.
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
# Production Docker images set WEB_DIST_PATH=/app/web.
# Set this to the exact number of trusted reverse-proxy hops in production.
TRUST_PROXY_HOPS=0

# External providers
# The fixture mode is reserved for deterministic local and CI browser tests.
ROUTE_PROVIDER_MODE=live
OPENROUTESERVICE_API_KEY=your_local_key
NLR_API_KEY=your_local_key

# Local infrastructure — activated in CHG-011
DATABASE_URL=postgresql://chargewise:chargewise@localhost:5433/chargewise
# Production releases may provide a direct PostgreSQL URL for migrations through
# MIGRATION_DATABASE_URL while DATABASE_URL uses the pooled runtime endpoint.
TEST_DATABASE_URL=postgresql://chargewise:chargewise@localhost:5433/chargewise_test
REDIS_URL=redis://localhost:6379

# Authentication — activated in CHG-021
SESSION_SECRET=replace_with_at_least_32_random_characters
