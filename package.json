{
  "name": "chargewise",
  "version": "0.1.0",
  "private": true,
  "description": "Full-stack EV charging intelligence platform for route-based charger discovery and personal charging analytics.",
  "scripts": {
    "dev": "pnpm --parallel --filter @chargewise/api --filter web run dev",
    "build": "pnpm -r run build",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r run typecheck",
    "db:check": "pnpm --filter @chargewise/database db:check",
    "check": "pnpm security:secrets && pnpm format:check && pnpm lint && pnpm typecheck && pnpm db:check && pnpm test && pnpm build",
    "security:secrets": "node scripts/check-tracked-secrets.mjs",
    "security:audit": "pnpm audit --prod --audit-level high",
    "security:check": "pnpm security:secrets && pnpm security:audit",
    "e2e:prepare": "pnpm --filter @chargewise/api exec tsx scripts/prepare-e2e.ts",
    "e2e": "pnpm e2e:prepare && playwright test",
    "e2e:headed": "pnpm e2e:prepare && playwright test --headed",
    "performance:route-search": "pnpm --filter @chargewise/api exec tsx scripts/measure-route-performance.ts",
    "deployment:migrate": "node apps/api/dist/deployment/migrate.js",
    "deployment:smoke": "node scripts/verify-deployment.mjs"
  },
  "author": "Erfan Sadri",
  "engines": {
    "node": ">=22.22.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.18.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.65.0"
  }
}
